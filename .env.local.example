# LeadForge AI — Environment Variables
# Copy this file: cp .env.local.example .env.local
# Then fill in your actual values below.

# ─── Supabase ───────────────────────────────────────────────────────────────
# Get these from: https://app.supabase.com → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# ─── OpenAI ─────────────────────────────────────────────────────────────────
# Get from: https://platform.openai.com/api-keys
# Optional — if omitted, falls back to template-based email generation
OPENAI_API_KEY=sk-your-openai-key-here

# ─── Google Places API ──────────────────────────────────────────────────────
# Get from: https://console.cloud.google.com → Enable "Places API (New)"
# Optional — if omitted, realistic mock data is used for demos
GOOGLE_PLACES_API_KEY=your-google-places-key-here

# ─── Site URL (Required for CORS security) ──────────────────────────────────
# LOCAL:      http://localhost:3000
# PRODUCTION: https://your-app.vercel.app  (your actual Vercel URL)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
